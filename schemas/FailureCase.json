{
  "$defs": {
    "SourceRef": {
      "properties": {
        "page_id": {
          "title": "Page Id",
          "type": "integer"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "integer"
        },
        "page_title": {
          "title": "Page Title",
          "type": "string"
        },
        "section_title": {
          "title": "Section Title",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "revision_id",
        "page_title",
        "section_title",
        "chunk_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "failure_id": {
      "title": "Failure Id",
      "type": "string"
    },
    "parent_seed_id": {
      "title": "Parent Seed Id",
      "type": "string"
    },
    "failure_type": {
      "enum": [
        "missing_evidence",
        "context_noise",
        "chunk_boundary",
        "evidence_position"
      ],
      "title": "Failure Type",
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Severity",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "gold_answer": {
      "title": "Gold Answer",
      "type": "string"
    },
    "supporting_sentence": {
      "title": "Supporting Sentence",
      "type": "string"
    },
    "contexts": {
      "items": {
        "type": "string"
      },
      "title": "Contexts",
      "type": "array"
    },
    "answer_available": {
      "default": true,
      "title": "Answer Available",
      "type": "boolean"
    },
    "expected_behavior": {
      "default": "answer",
      "enum": [
        "answer",
        "abstain"
      ],
      "title": "Expected Behavior",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "category_group": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category Group"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "failure_id",
    "parent_seed_id",
    "failure_type",
    "severity",
    "question",
    "gold_answer",
    "supporting_sentence",
    "source"
  ],
  "title": "FailureCase",
  "type": "object"
}