# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.env.*
!.env.example

# Data artifacts (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/generated/*
!data/generated/.gitkeep
data/validated/*
!data/validated/.gitkeep
data/final/*
!data/final/.gitkeep
!data/final/failures/
data/final/failures/*
!data/final/failures/.gitkeep
data/runs/

# Reports
reports/*
!reports/.gitkeep

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local
tmp.md
*.log
