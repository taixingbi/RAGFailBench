# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env
.env.*
!.env.example

# Data artifacts (keep directory structure via .gitkeep)
data/1_raw/*
!data/1_raw/.gitkeep
data/2_interim/*
!data/2_interim/.gitkeep
data/3_processed/*
!data/3_processed/.gitkeep
data/4_generated/*
!data/4_generated/.gitkeep
data/5_validated/*
!data/5_validated/.gitkeep
data/6_final/*
!data/6_final/.gitkeep
!data/6_final/failures/
data/6_final/failures/*
!data/6_final/failures/.gitkeep
data/runs/

# Reports
reports/*
!reports/.gitkeep

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local
tmp.md
*.log
.env copy.example

# Human review packs (regenerate with `make export-review`)
reviews/*
!reviews/.gitkeep
!reviews/README.md
